# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=jira_notifications_channel_id

# Jira
JIRA_HOST=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=LP

# Server
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxx...

# Meeting Webhook (회의록 요약 전송)
MEETING_WEBHOOK_SECRET=your_meeting_webhook_secret
MEETING_CHANNEL_ID=document_notifications_channel_id

# Document Webhook (AI 작업 결과물 발행)
DOCUMENT_WEBHOOK_SECRET=your_document_webhook_secret
DOCUMENT_CHANNEL_ID=document_notifications_channel_id
